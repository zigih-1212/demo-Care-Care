{
  "expo": {
    "name": "Cara Care",
    "slug": "carecare-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "carecare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./public/icon-512.png",
    "splash": {
      "backgroundColor": "#0E7C7B",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carecare.demo",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Cara Care to protect your health data."
      }
    },
    "android": {
      "package": "com.carecare.demo",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#0E7C7B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    },
    "plugins": ["expo-secure-store"]
  }
}
