# Cloudflare Pages / Netlify headers.
# Hashed Expo bundles are immutable; the service worker must always be revalidated
# so a new deploy is picked up instead of being served from cache forever.
/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
