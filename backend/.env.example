# Example environment file for the backend. Copy to .env and fill in.
# NEVER commit a real .env — it is git-ignored.
DJANGO_SETTINGS_MODULE=carecare.settings.dev
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string-please-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://carecare:carecare@localhost:5432/carecare
REDIS_URL=redis://localhost:6379/0

# Optional observability / error reporting.
SENTRY_DSN=
AUDIT_SINK_URL=

# How far back a patient may backdate a symptom entry.
SYMPTOM_MAX_BACKDATE_DAYS=7
